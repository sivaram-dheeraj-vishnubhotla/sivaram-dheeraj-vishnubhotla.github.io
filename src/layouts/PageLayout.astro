---
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.intro } = Astro.props;
const path = Astro.url.pathname;
const navItems = [
  ['/', 'Home'],
  ['/about/', 'About me'],
  ['/projects/', 'Projects'],
  ['/blog/', 'Writing'],
  [site.links.resume, 'Resume']
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title} — {site.role}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label={`${site.name} home`}><span>SV</span>{site.shortName}</a>
      <div class="nav-wrap">
        <div class="header-actions">
          <a class="contact-link" href="/#contact" aria-label="Contact me" title="Contact me">Contact me</a>
          <button class="theme-toggle" type="button" aria-label="Toggle color theme">☀</button>
        </div>
        <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <nav class="site-nav" aria-label="Primary navigation">
          <div class="nav-links">
            {navItems.map(([href, label]) => <a class:list={{ active: !String(href).startsWith('http') && path === href }} href={href} target={String(href).startsWith('http') ? '_blank' : undefined} rel={String(href).startsWith('http') ? 'noreferrer' : undefined}>{label}</a>)}
          </div>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span>Turning ideas into intelligent machines.</span>
    </footer>
    <script>
      const root = document.documentElement;
      const nav = document.querySelector('.site-nav');
      const menuToggle = document.querySelector('.menu-toggle');
      const toggle = document.querySelector('.theme-toggle');
      const scrollCue = document.querySelector('.scroll-cue');
      const saved = localStorage.getItem('theme');
      if (saved === 'dark') {
        root.dataset.theme = 'dark';
        if (toggle) toggle.textContent = '☾';
      }
      menuToggle?.addEventListener('click', () => {
        const isOpen = nav?.classList.toggle('is-open');
        if (menuToggle) menuToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });
      toggle?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
        toggle.textContent = next === 'dark' ? '☾' : '☀';
      });
      const updateScrollCue = () => {
        scrollCue?.classList.toggle('is-hidden', window.scrollY > 8);
      };
      updateScrollCue();
      window.addEventListener('scroll', updateScrollCue, { passive: true });
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (!nav?.contains(target) && !menuToggle?.contains(target)) {
          nav?.classList.remove('is-open');
          menuToggle?.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }
      });
    </script>
  </body>
</html>

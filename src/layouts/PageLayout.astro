---
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.intro } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title} — {site.role}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label={`${site.name} home`}><span>SV</span>{site.shortName}</a>
      <nav aria-label="Primary navigation">
        {[
          ['/about/', 'About me'],
          ['/projects/', 'Projects'],
          ['/blog/', 'Writing'],
          [site.links.resume, 'Resume']
        ].map(([href, label]) => <a class:list={{ active: !String(href).startsWith('http') && path === href }} href={href} target={String(href).startsWith('http') ? '_blank' : undefined} rel={String(href).startsWith('http') ? 'noreferrer' : undefined}>{label}</a>)}
        <button class="theme-toggle" type="button" aria-label="Toggle color theme">☀</button>
        <a class="contact-link" href="/#contact" aria-label="Contact me" title="Contact me">Contact me</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span>Built for robots, systems, and careful questions.</span>
    </footer>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector('.theme-toggle');
      const saved = localStorage.getItem('theme');
      if (saved === 'dark') {
        root.dataset.theme = 'dark';
        if (toggle) toggle.textContent = '☾';
      }
      toggle?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
        toggle.textContent = next === 'dark' ? '☾' : '☀';
      });
    </script>
  </body>
</html>

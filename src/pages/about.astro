---
import PageLayout from '../layouts/PageLayout.astro';
import { education, site, skills, workHistory } from '../data/site';
---
<PageLayout title={`About — ${site.name}`}>
  <section class="page-intro"><p class="kicker">About</p><h1>Robots are systems questions made physical.</h1><p>{site.intro}</p></section>
  <section class="content-grid"><div><p class="eyebrow">The longer version</p></div><div><p>{site.aboutLong}</p><p>{site.aboutShort}</p></div></section>
  <section class="content-grid"><div><p class="eyebrow">Education</p></div><div class="list">{education.map((item) => <div class="list-item"><span class="meta">{item.period}</span><div><h3>{item.degree}</h3><p>{item.institution}</p></div></div>)}</div></section>
  <section class="content-grid"><div><p class="eyebrow">Work history</p></div><div class="list">{workHistory.map((item) => <div class="list-item"><span class="meta">{item.period}</span><div><h3>{item.role}</h3><p>{item.organization}</p><p>{item.description}</p></div></div>)}</div></section>
  <section class="content-grid"><div><p class="eyebrow">Technical skills</p></div><div class="tags">{skills.map((skill) => <span class="tag">{skill}</span>)}</div></section>
  <section class="content-grid"><div><p class="eyebrow">Links</p></div><div class="actions"><a class="button" href={site.links.github} target="_blank" rel="noreferrer">GitHub ↗</a><a class="button secondary" href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a class="button secondary" href={site.links.scholar} target="_blank" rel="noreferrer">Google Scholar ↗</a><a class="button secondary" href="/resume/">Resume →</a></div></section>
</PageLayout>

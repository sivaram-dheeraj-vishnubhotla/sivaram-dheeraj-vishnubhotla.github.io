---
import PageLayout from '../layouts/PageLayout.astro';
import { education, site, skillGroups, workHistory } from '../data/site';
---
<PageLayout title={`About — ${site.name}`}>
  <section class="content-grid summary-grid"><div><p class="eyebrow">Summary</p></div><div><p>I’m a Robotics Engineer with an M.Eng. in Robotics and experience across robotic simulation, digital twins, XR, computer vision, reinforcement learning, and robotics software. My current work focuses on NVIDIA Isaac Sim, Omniverse, ROS 2, and UR5 systems, including VR teleoperation, sim-to-real workflows, interactive XR digital twins, and vision-guided manipulation using camera-based localization and perception.</p><p>My broader experience spans multi-robot systems, reinforcement learning, computer vision pipelines, backend development, and cloud-based automation. I’ve worked with Python, C++, FastAPI, PostgreSQL, AWS, OpenCV, PyTorch, Gazebo, and related tools to build systems that connect simulation, perception, software, and physical hardware. I’m especially interested in robotics work where simulation and digital environments play a central role in developing, testing, and deploying real robotic systems.</p></div></section>
  <section id="experience" class="content-grid"><div><p class="eyebrow">Experience</p></div><div class="list">{workHistory.map((item) => <div class="list-item"><span class="meta">{item.period}</span><div><h3>{item.role}</h3><p>{item.organization}</p><ul class="bullet-list">{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul></div></div>)}</div></section>
  <section class="content-grid"><div><p class="eyebrow">Education</p></div><div class="list">{education.map((item) => <div class="list-item"><span class="meta">{item.period}</span><div><h3>{item.degree}</h3><p>{item.institution}</p></div></div>)}</div></section>
  <section class="content-grid"><div><p class="eyebrow">Technical skills</p></div><div class="skill-groups">{skillGroups.map((group) => <div class="skill-group"><h3>{group.category}</h3><div class="tags">{group.items.map((skill) => <span class="tag">{skill}</span>)}</div></div>)}</div></section>
  <section class="content-grid"><div><p class="eyebrow">Links</p></div><div class="actions"><a class="button" href={site.links.github} target="_blank" rel="noreferrer">GitHub ↗</a><a class="button secondary" href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a class="button secondary" href={site.links.scholar} target="_blank" rel="noreferrer">Google Scholar ↗</a><a class="button secondary" href={site.links.resume} target="_blank" rel="noreferrer">Resume ↗</a></div></section>
</PageLayout>

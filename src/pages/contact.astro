---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../data/site';
---
<PageLayout title={`Contact — ${site.name}`}>
  <section class="page-intro"><p class="kicker">Contact</p><h1>Let’s build something that moves.</h1><p>For robotics engineering, simulation, digital twins, or research conversations, the best way to reach me is by email.</p><div class="actions"><a class="button" href={site.links.email}>Email {site.name}</a><a class="button secondary" href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a></div></section>
  <section class="content-grid"><div><p class="eyebrow">Elsewhere</p></div><div class="list"><a class="list-item" href={site.links.github} target="_blank" rel="noreferrer"><span class="meta">Code</span><div><h3>GitHub</h3><p>Projects, experiments, and technical work.</p></div></a><a class="list-item" href={site.links.linkedin} target="_blank" rel="noreferrer"><span class="meta">Profile</span><div><h3>LinkedIn</h3><p>Professional background and experience.</p></div></a><a class="list-item" href={site.links.scholar} target="_blank" rel="noreferrer"><span class="meta">Research</span><div><h3>Google Scholar</h3><p>Publications and citation profile.</p></div></a></div></section>
</PageLayout>
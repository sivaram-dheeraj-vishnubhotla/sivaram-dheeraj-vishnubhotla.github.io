---
import PageLayout from '../layouts/PageLayout.astro';
import { site, projects } from '../data/site';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).filter((post) => !post.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 2);
const featuredProjects = projects.slice(0, 3);
---
<PageLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">{site.role} · {site.location}</p>
      <h1>{site.name}</h1>
      <p class="lede">{site.intro}</p>
      <div class="actions"><a class="button" href="/projects/">Projects</a><a class="button secondary" href="/about/">About me</a></div>
    </div>
    <div class="hero-photo"><img src="/profile.jpg" alt={`${site.name} standing beside a car`} /></div>
    <a class="scroll-cue" href="#home-about" aria-label="Scroll to About me">↓</a>
  </section>

  <section id="home-about" class="section home-about">
    <div class="content-grid">
      <div><p class="eyebrow">About me</p></div>
      <div>
        <p>I work across robotics simulation, XR interaction, computer vision, backend systems, and hardware-software integration, with a focus on turning complex experiments into usable systems.</p>
        <div class="about-links">
          <a class="more-about-link" href="/about/">More about me →</a>
          <a class="more-about-link" href={site.links.resume} target="_blank" rel="noreferrer">View resume →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="eyebrow">02 / Current work</p><h2>Inside the robotics lab</h2></div></div>
    <div class="lab">
      <div class="lab-media">[ Isaac Sim / UR5 / teleoperation media ]</div>
      <div class="lab-copy"><div><h3>{site.currentWork}</h3><p>{site.focus}. This space is ready for real simulator captures, hardware photography, demo video, and system diagrams as the work develops.</p></div><a class="button secondary" href="/about/#experience">View experience</a></div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="eyebrow">03 / Projects</p></div><a href="/projects/">All projects →</a></div>
    <div class="grid">{featuredProjects.map((project) => <article class="project-card"><div class="media">{project.image ? <img src={project.image} alt={`${project.title} project preview`} loading="lazy" /> : '[ project image / video ]'}</div><p class="meta">{project.status}</p><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></article>)}</div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="eyebrow">04 / Writing</p><h2>Recent notes</h2></div><a href="/blog/">Writing archive →</a></div>
    <div class="list">{posts.map((post) => <a class="list-item" href={`/blog/${post.id}/`}><span class="meta">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</span><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div></a>)}</div>
  </section>

  <section id="contact" class="section contact-strip">
    <div class="section-heading"><div><p class="eyebrow">05 / Contact</p><h2>Let’s talk robotics.</h2></div></div>
    <p class="lede">For research, robotics, and simulation conversations, reach out directly.</p>
    <div class="actions"><a class="button" href={site.links.email}>Email me</a><a class="button secondary" href={site.links.github} target="_blank" rel="noreferrer">GitHub ↗</a><a class="button secondary" href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a class="button secondary" href={site.links.scholar} target="_blank" rel="noreferrer">Google Scholar ↗</a></div>
  </section>
</PageLayout>

---
import PageLayout from '../layouts/PageLayout.astro';
import { site, projects } from '../data/site';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).filter((post) => !post.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 2);
---
<PageLayout>
  <section class="hero">
    <p class="kicker">{site.role} · {site.location}</p>
    <h1>{site.name}</h1>
    <p class="lede">{site.intro}</p>
    <div class="actions"><a class="button" href="/projects/">Explore selected work</a><a class="button secondary" href="/about/">About me</a></div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="eyebrow">01 / Current work</p><h2>Inside the robotics lab</h2></div><span class="meta">An evolving field note</span></div>
    <div class="lab">
      <div class="lab-media">[ Isaac Sim / UR5 / teleoperation media ]</div>
      <div class="lab-copy"><div><h3>{site.currentWork}</h3><p>{site.focus}. This space is ready for real simulator captures, hardware photography, demo video, and system diagrams as the work develops.</p></div><a class="button secondary" href="/projects/">View project archive</a></div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="eyebrow">02 / Selected work</p><h2>Systems in progress</h2></div><a href="/projects/">All projects →</a></div>
    <div class="grid">{projects.map((project) => <article class="project-card"><div class="media">{project.image || '[ project image / video ]'}</div><p class="meta">{project.status}</p><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></article>)}</div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="eyebrow">03 / Writing</p><h2>Recent notes</h2></div><a href="/blog/">Writing archive →</a></div>
    <div class="list">{posts.map((post) => <a class="list-item" href={`/blog/${post.slug}/`}><span class="meta">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</span><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div></a>)}</div>
  </section>
</PageLayout>
